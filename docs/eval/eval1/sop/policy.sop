@input caseId noticeDays expeditedRequested writtenConsentRecorded
@output finding

@evaluate define caseId noticeDays expeditedRequested writtenConsentRecorded
    function run({ caseId, noticeDays, expeditedRequested, writtenConsentRecorded }, ctx) {
      const days = Number(noticeDays)
      if (!Number.isFinite(days) || days < 0) return ctx.reject("invalid_notice_days", { caseId, noticeDays })
      if (!["true", "false"].includes(expeditedRequested)) return ctx.reject("invalid_expedited_flag", { caseId })
      if (!["true", "false"].includes(writtenConsentRecorded)) return ctx.reject("invalid_consent_flag", { caseId })
      const exceptionUsed = expeditedRequested === "true" && writtenConsentRecorded === "true"
      const applicableMinimum = exceptionUsed ? 10 : 30
      const compliant = days >= applicableMinimum
      return {
        id: caseId,
        noticeDays: days,
        applicableMinimum,
        exceptionUsed,
        compliant,
        reason: compliant ? "applicable_minimum_met" : "notice_below_applicable_minimum"
      }
    }
    return { run }

@finding evaluate $caseId $noticeDays $expeditedRequested $writtenConsentRecorded
