@input datasetJson
@output verdict witness mean

@evaluate define datasetJson
    function run({ datasetJson }, ctx) {
      let values
      try {
        values = JSON.parse(datasetJson)
      } catch {
        return ctx.reject("invalid_json")
      }
      if (!Array.isArray(values) || values.length === 0) return ctx.reject("nonempty_array_required")
      if (values.some((value) => typeof value !== "number" || !Number.isFinite(value))) {
        return ctx.reject("finite_numbers_required")
      }
      const witness = values.find((value) => value <= 0)
      const mean = values.reduce((sum, value) => sum + value, 0) / values.length
      return {
        verdict: witness === undefined ? "SUPPORTED_FOR_DATASET" : "REFUTED",
        witness: witness === undefined ? null : witness,
        mean
      }
    }
    return { run }

@evaluation evaluate $datasetJson
@verdict get $evaluation "/verdict"
@witness get $evaluation "/witness"
@mean get $evaluation "/mean"
