@input
@output verdict witness mean
@goal grounded covers verdict witness

@dataset eval2.dataset
@verdict @witness @mean eval2.counterexample $dataset

@verifyWitness define dataset verdict witness
    function run({ dataset, verdict, witness }) {
      const values = dataset
      if (verdict !== "REFUTED") return witness === null
      return values.includes(witness) && witness <= 0
    }
    return { run }

@witnessValid verifyWitness $dataset $verdict $witness
@grounded assertInvariant $witnessValid "eval2.counterexample-grounded"
