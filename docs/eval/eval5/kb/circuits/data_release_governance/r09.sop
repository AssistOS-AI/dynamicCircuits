@input release
@output finding
@invariant findingIdentified covers finding

@evaluate define release
    function run({ release }, ctx) {
      if (release === null || typeof release !== "object" || Array.isArray(release)) {
        return ctx.reject("release_record_must_be_an_object", { ruleId: "R09" })
      }
      const normalized = typeof release.incidentOwner === "string" ? release.incidentOwner.trim() : ""
      const passes = normalized.length > 0 && normalized !== "missing"
      return {
        ruleId: "R09",
        status: passes ? "PASS" : "FAIL",
        reason: passes ? null : "incident_owner_required",
        path: "APPLICABLE",
        sourceLocator: "input/knowledge-base.md:85"
      }
    }
    function check(inputs, output) {
      return output.ruleId === "R09" && ["PASS", "FAIL"].includes(output.status)
    }
    return { run, check }

@finding evaluate $release
@ruleId get $finding "ruleId"
@ruleIdCorrect equal $ruleId "R09"
@findingIdentified assertInvariant $ruleIdCorrect "R09 finding must retain its rule identifier"
