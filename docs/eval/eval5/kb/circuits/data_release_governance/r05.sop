@input release
@output finding
@invariant findingIdentified covers finding

@evaluate define release
    function run({ release }, ctx) {
      if (release === null || typeof release !== "object" || Array.isArray(release)) {
        return ctx.reject("release_record_must_be_an_object", { ruleId: "R05" })
      }
      const supported = ["public", "internal", "confidential", "restricted"]
      if (!supported.includes(release.sensitivity)) {
        return ctx.reject("unsupported_sensitivity", { ruleId: "R05", sensitivity: release.sensitivity })
      }
      const applicable = release.sensitivity !== "public"
      const passes = !applicable || release.accessLogging === true
      return {
        ruleId: "R05",
        status: passes ? "PASS" : "FAIL",
        reason: passes ? null : "non_public_release_requires_access_logging",
        path: applicable ? "APPLICABLE" : "NOT_APPLICABLE",
        sourceLocator: "input/knowledge-base.md:51"
      }
    }
    function check(inputs, output) {
      return output.ruleId === "R05" && ["PASS", "FAIL"].includes(output.status)
    }
    return { run, check }

@finding evaluate $release
@ruleId get $finding "ruleId"
@ruleIdCorrect equal $ruleId "R05"
@findingIdentified assertInvariant $ruleIdCorrect "R05 finding must retain its rule identifier"
