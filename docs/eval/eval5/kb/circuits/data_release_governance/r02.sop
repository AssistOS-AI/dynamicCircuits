@input release
@output finding
@invariant findingIdentified covers finding

@evaluate define release
    function run({ release }, ctx) {
      if (release === null || typeof release !== "object" || Array.isArray(release)) {
        return ctx.reject("release_record_must_be_an_object", { ruleId: "R02" })
      }
      const supported = ["public", "internal", "confidential", "restricted"]
      if (!supported.includes(release.sensitivity)) {
        return ctx.reject("unsupported_sensitivity", { ruleId: "R02", sensitivity: release.sensitivity })
      }
      const applicable = ["confidential", "restricted"].includes(release.sensitivity)
      const passes = !applicable || release.encryptionAtRest === true
      return {
        ruleId: "R02",
        status: passes ? "PASS" : "FAIL",
        reason: passes ? null : "sensitive_release_requires_encryption",
        path: applicable ? "APPLICABLE" : "NOT_APPLICABLE",
        sourceLocator: "input/knowledge-base.md:25"
      }
    }
    function check(inputs, output) {
      return output.ruleId === "R02" && ["PASS", "FAIL"].includes(output.status)
    }
    return { run, check }

@finding evaluate $release
@ruleId get $finding "ruleId"
@ruleIdCorrect equal $ruleId "R02"
@findingIdentified assertInvariant $ruleIdCorrect "R02 finding must retain its rule identifier"
