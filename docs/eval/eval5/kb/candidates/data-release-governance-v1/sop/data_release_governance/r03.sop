@input release
@output finding
@invariant findingIdentified covers finding

@evaluate define release
    function run({ release }, ctx) {
      if (release === null || typeof release !== "object" || Array.isArray(release)) {
        return ctx.reject("release_record_must_be_an_object", { ruleId: "R03" })
      }
      const passes = Number.isInteger(release.retentionDays)
        && release.retentionDays >= 1
        && release.retentionDays <= 365
      return {
        ruleId: "R03",
        status: passes ? "PASS" : "FAIL",
        reason: passes ? null : "retention_must_be_between_1_and_365_days",
        path: "APPLICABLE",
        sourceLocator: "input/knowledge-base.md:34"
      }
    }
    function check(inputs, output) {
      return output.ruleId === "R03" && ["PASS", "FAIL"].includes(output.status)
    }
    return { run, check }

@finding evaluate $release
@ruleId get $finding "ruleId"
@ruleIdCorrect equal $ruleId "R03"
@findingIdentified assertInvariant $ruleIdCorrect "R03 finding must retain its rule identifier"
