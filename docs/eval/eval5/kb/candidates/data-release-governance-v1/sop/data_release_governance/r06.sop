@input release
@output finding
@invariant findingIdentified covers finding

@evaluate define release
    function run({ release }, ctx) {
      if (release === null || typeof release !== "object" || Array.isArray(release)) {
        return ctx.reject("release_record_must_be_an_object", { ruleId: "R06" })
      }
      if (typeof release.externalProcessors !== "boolean") {
        return ctx.reject("external_processors_must_be_boolean", { ruleId: "R06" })
      }
      const applicable = release.externalProcessors
      const passes = !applicable || release.dpaStatus === "signed"
      return {
        ruleId: "R06",
        status: passes ? "PASS" : "FAIL",
        reason: passes ? null : "external_processor_requires_signed_dpa",
        path: applicable ? "APPLICABLE" : "NOT_APPLICABLE",
        sourceLocator: "input/knowledge-base.md:60"
      }
    }
    function check(inputs, output) {
      return output.ruleId === "R06" && ["PASS", "FAIL"].includes(output.status)
    }
    return { run, check }

@finding evaluate $release
@ruleId get $finding "ruleId"
@ruleIdCorrect equal $ruleId "R06"
@findingIdentified assertInvariant $ruleIdCorrect "R06 finding must retain its rule identifier"
