@input release
@output finding
@invariant findingIdentified covers finding

@evaluate define release
    function run({ release }, ctx) {
      if (release === null || typeof release !== "object" || Array.isArray(release)) {
        return ctx.reject("release_record_must_be_an_object", { ruleId: "R04" })
      }
      const normalized = typeof release.deletionOwner === "string" ? release.deletionOwner.trim() : ""
      const passes = normalized.length > 0 && normalized !== "missing"
      return {
        ruleId: "R04",
        status: passes ? "PASS" : "FAIL",
        reason: passes ? null : "deletion_owner_required",
        path: "APPLICABLE",
        sourceLocator: "input/knowledge-base.md:42"
      }
    }
    function check(inputs, output) {
      return output.ruleId === "R04" && ["PASS", "FAIL"].includes(output.status)
    }
    return { run, check }

@finding evaluate $release
@ruleId get $finding "ruleId"
@ruleIdCorrect equal $ruleId "R04"
@findingIdentified assertInvariant $ruleIdCorrect "R04 finding must retain its rule identifier"
