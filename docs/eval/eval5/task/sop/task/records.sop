@records makeRecords

@validateRecords define records
    function run({ records }) {
      return Array.isArray(records)
        && records.length === 10
        && records.every((record) => typeof record.sourceLocator === "string")
    }
    return { run }

@recordsValid validateRecords $records
@recordsAccepted assertInvariant $recordsValid "all ten manifest-sourced release records must be present"
