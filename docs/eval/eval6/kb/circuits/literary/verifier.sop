@input brief markdown
@output verification

@verify define brief markdown
    function refusalForInputs(brief, markdown, ctx) {
      if (brief === null || typeof brief !== "object" || Array.isArray(brief)) {
        return ctx.reject("BRIEF_NOT_OBJECT")
      }
      const scalarFields = [
        "title",
        "protagonist",
        "setting",
        "object",
        "immediateGoal",
        "obstacle",
        "choice",
        "consequence",
        "closingImage",
      ]
      for (const field of scalarFields) {
        if (brief[field] === undefined) return ctx.reject("MISSING_FIELD", { field })
        if (typeof brief[field] !== "string") return ctx.reject("NON_STRING_FIELD", { field })
        if (brief[field].trim().length === 0) return ctx.reject("EMPTY_FIELD", { field })
      }
      if (brief.motifs === undefined) return ctx.reject("MISSING_FIELD", { field: "motifs" })
      if (!Array.isArray(brief.motifs)) return ctx.reject("MOTIFS_NOT_ARRAY")
      if (brief.motifs.length !== 3) {
        return ctx.reject("INVALID_MOTIF_COUNT", { actual: brief.motifs.length, expected: 3 })
      }
      for (let index = 0; index < brief.motifs.length; index += 1) {
        if (typeof brief.motifs[index] !== "string") {
          return ctx.reject("NON_STRING_MOTIF", { index })
        }
        if (brief.motifs[index].trim().length === 0) {
          return ctx.reject("EMPTY_MOTIF", { index })
        }
      }
      if (/\r|\n/.test(brief.title)) return ctx.reject("TITLE_CONTAINS_NEWLINE")
      if (typeof markdown !== "string") return ctx.reject("MARKDOWN_NOT_STRING")
      return null
    }

    function occurrences(text, needle) {
      let count = 0
      let offset = 0
      while (offset <= text.length - needle.length) {
        const found = text.indexOf(needle, offset)
        if (found < 0) break
        count += 1
        offset = found + needle.length
      }
      return count
    }

    function visibleWordCount(markdown) {
      const visible = markdown.replace(/^#{1,6}\s+/gm, "").trim()
      return visible.length === 0 ? 0 : visible.split(/\s+/).length
    }

    function approvedMarkdown(brief) {
      return [
        "# " + brief.title,
        "",
        "## Arrival",
        brief.protagonist + " is present in " + brief.setting + ". The concrete object is " + brief.object
          + ", and the immediate goal is " + brief.immediateGoal
          + ". These supplied details define the arrival: the protagonist, setting, object, and purpose remain together,"
          + " while the opening adds no name, fact, quotation, or event beyond the brief.",
        "",
        "## Pressure",
        "The obstacle is " + brief.obstacle + ". Under that pressure, the first motif recurs: " + brief.motifs[0]
          + ". The obstacle stands against the immediate goal, and the assigned motif marks that pressure without"
          + " introducing another decision, consequence, person, place, object, or event.",
        "",
        "## Choice",
        "The supplied choice is " + brief.choice + ". The second motif accompanies it: " + brief.motifs[1]
          + ". This is the decisive turn named by the brief; the paragraph holds to that choice, lets the assigned motif"
          + " echo beside it, and adds no alternative action or outcome.",
        "",
        "## Consequence",
        "The supplied consequence is " + brief.consequence + ". The third motif remains with its aftermath: "
          + brief.motifs[2] + ". No further event follows; the consequence settles into the required final image, and the"
          + " vignette closes exactly there: " + brief.closingImage,
      ].join("\n")
    }

    function run({ brief, markdown }, ctx) {
      const refusal = refusalForInputs(brief, markdown, ctx)
      if (refusal) return refusal

      const expectedHeadings = [
        "# " + brief.title,
        "## Arrival",
        "## Pressure",
        "## Choice",
        "## Consequence",
      ]
      const lines = markdown.replace(/\r\n/g, "\n").replace(/\r/g, "\n").split("\n")
      const headingLines = lines.filter((line) => /^#{1,6}\s+/.test(line))
      const exactHeadingOrder = headingLines.length === expectedHeadings.length
        && headingLines.every((line, index) => line === expectedHeadings[index])
      const levelTwoHeadings = headingLines.filter((line) => /^##\s+/.test(line))
      const exactlyFourBodySections = levelTwoHeadings.length === 4
        && levelTwoHeadings.every((line, index) => line === expectedHeadings[index + 1])
      const noExtraHeadings = headingLines.length === expectedHeadings.length
        && headingLines.every((line) => expectedHeadings.includes(line))

      const sectionNames = ["Arrival", "Pressure", "Choice", "Consequence"]
      const sectionTexts = {}
      const paragraphCounts = {}
      let orderedSectionsAvailable = true
      let previousIndex = -1
      for (const sectionName of sectionNames) {
        const heading = "## " + sectionName
        const index = lines.indexOf(heading)
        if (index < 0 || index <= previousIndex) orderedSectionsAvailable = false
        previousIndex = index
      }
      for (let sectionIndex = 0; sectionIndex < sectionNames.length; sectionIndex += 1) {
        const sectionName = sectionNames[sectionIndex]
        const heading = "## " + sectionName
        const start = lines.indexOf(heading)
        const next = sectionIndex + 1 < sectionNames.length
          ? lines.indexOf("## " + sectionNames[sectionIndex + 1])
          : lines.length
        const body = orderedSectionsAvailable ? lines.slice(start + 1, next).join("\n").trim() : ""
        sectionTexts[sectionName] = body
        paragraphCounts[sectionName] = body.length === 0
          ? 0
          : body.split(/\n\s*\n/).filter((paragraph) => paragraph.trim().length > 0).length
      }
      const oneParagraphPerSection = orderedSectionsAvailable
        && sectionNames.every((sectionName) => paragraphCounts[sectionName] === 1)

      const scalarFields = [
        "title",
        "protagonist",
        "setting",
        "object",
        "immediateGoal",
        "obstacle",
        "choice",
        "consequence",
        "closingImage",
      ]
      const fieldOccurrences = {}
      const missingRequirements = []
      for (const field of scalarFields) {
        fieldOccurrences[field] = occurrences(markdown, brief[field])
        if (fieldOccurrences[field] === 0) missingRequirements.push("field:" + field)
      }
      const motifOccurrences = []
      for (let index = 0; index < brief.motifs.length; index += 1) {
        const count = occurrences(markdown, brief.motifs[index])
        motifOccurrences.push(count)
        if (count === 0) missingRequirements.push("motif:" + (index + 1))
      }
      const allBriefFieldsPresent = scalarFields.every((field) => fieldOccurrences[field] > 0)
        && motifOccurrences.every((count) => count > 0)

      const motifPlacement = [
        sectionTexts.Pressure.includes(brief.motifs[0]),
        sectionTexts.Choice.includes(brief.motifs[1]),
        sectionTexts.Consequence.includes(brief.motifs[2]),
      ]
      for (let index = 0; index < motifPlacement.length; index += 1) {
        if (!motifPlacement[index]) missingRequirements.push("motif-placement:" + (index + 1))
      }
      const motifsInAssignedSections = motifPlacement.every((placed) => placed)
      const assignedNarrativeFieldsPresent = sectionTexts.Arrival.includes(brief.protagonist)
        && sectionTexts.Arrival.includes(brief.setting)
        && sectionTexts.Arrival.includes(brief.object)
        && sectionTexts.Arrival.includes(brief.immediateGoal)
        && sectionTexts.Pressure.includes(brief.obstacle)
        && sectionTexts.Choice.includes(brief.choice)
        && sectionTexts.Consequence.includes(brief.consequence)
        && sectionTexts.Consequence.includes(brief.closingImage)
      if (!assignedNarrativeFieldsPresent) missingRequirements.push("narrative-field-section-placement")
      const closingImageAtEnd = markdown.trimEnd().endsWith(brief.closingImage)
      if (!closingImageAtEnd) missingRequirements.push("closing-image-at-end")

      const wordCount = visibleWordCount(markdown)
      const wordCountInRange = wordCount >= 90 && wordCount <= 220
      if (!wordCountInRange) missingRequirements.push("word-count:90..220")

      const unexpectedStructuralConditions = []
      if (!exactHeadingOrder) unexpectedStructuralConditions.push("HEADING_ORDER_MISMATCH")
      if (!exactlyFourBodySections) unexpectedStructuralConditions.push("BODY_SECTION_COUNT_NOT_FOUR")
      if (!oneParagraphPerSection) unexpectedStructuralConditions.push("PARAGRAPH_COUNT_NOT_ONE_PER_SECTION")
      if (!noExtraHeadings) unexpectedStructuralConditions.push("EXTRA_OR_UNEXPECTED_HEADING")
      const approvedContentOnly = markdown === approvedMarkdown(brief)
      if (!approvedContentOnly) unexpectedStructuralConditions.push("UNAPPROVED_OR_ALTERED_CONTENT")

      const checks = [
        { id: "exact-heading-order", ok: exactHeadingOrder },
        { id: "exactly-four-body-sections", ok: exactlyFourBodySections },
        { id: "one-non-empty-paragraph-per-section", ok: oneParagraphPerSection },
        { id: "all-brief-fields-present-verbatim", ok: allBriefFieldsPresent },
        { id: "motifs-in-assigned-sections", ok: motifsInAssignedSections },
        { id: "narrative-fields-in-assigned-sections", ok: assignedNarrativeFieldsPresent },
        { id: "closing-image-at-end", ok: closingImageAtEnd },
        { id: "no-extra-headings", ok: noExtraHeadings },
        { id: "word-count-90-through-220", ok: wordCountInRange },
        { id: "approved-fixed-content-only", ok: approvedContentOnly },
      ]
      return {
        ok: checks.every((check) => check.ok),
        checks,
        missingRequirements,
        unexpectedStructuralConditions,
        counts: {
          headings: headingLines.length,
          levelOneHeadings: headingLines.filter((line) => /^#\s+/.test(line)).length,
          levelTwoHeadings: levelTwoHeadings.length,
          bodySections: levelTwoHeadings.length,
          paragraphsBySection: paragraphCounts,
          words: wordCount,
          fieldOccurrences,
          motifOccurrences,
        },
      }
    }

    function check(inputs, output) {
      return output !== null
        && typeof output === "object"
        && typeof output.ok === "boolean"
        && Array.isArray(output.checks)
        && output.checks.length === 10
        && output.checks.every((item) => typeof item.id === "string" && typeof item.ok === "boolean")
        && output.ok === output.checks.every((item) => item.ok)
        && Array.isArray(output.missingRequirements)
        && Array.isArray(output.unexpectedStructuralConditions)
        && output.counts !== null
        && typeof output.counts === "object"
    }

    return { run, check }

@verification verify $brief $markdown
